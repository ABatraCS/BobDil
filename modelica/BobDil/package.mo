package BobDil "BobDil driver-in-the-loop Modelica"
  annotation(
    version = "0.1.0",
    Documentation(info = "<html><p>
Modelica owned by BobDil. Everything here is additive: BobLib is read, never
modified, so a BobLib version bump is never blocked on BobDil and BobDil can be
cloned and built on its own.
</p></html>"));
end BobDil;
